<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces "inter-inter"}}}

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 297mm; height: 210mm;
      font-family: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #1c2f6b;
      -webkit-font-smoothing: antialiased;
    }
    .page {
      width: 297mm; height: 210mm;
      position: relative; overflow: hidden; background: #fff;
    }

    /* Full-page wave decoration SVG (absolute positioned, covers the page) */
    .waves-decor {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    /* Bottom navy waves */
    .waves-bottom {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      width: 100%; height: 120px;
      z-index: 1;
      pointer-events: none;
    }

    /* Main content column */
    .content {
      position: absolute;
      top: 0; left: 0; right: 0;
      bottom: 120px;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 18px 55px 0;
    }

    .logo {
      display: block;
      max-height: 52px;
      width: auto;
      margin-bottom: 4px;
    }

    .cert-title {
      font-size: 46px;
      font-weight: 800;
      color: #1a3a8f;
      letter-spacing: 2px;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 7px;
      line-height: 1;
    }

    .preamble {
      font-size: 13px;
      color: #444;
      text-align: center;
      margin-bottom: 3px;
    }

    .recipient-name {
      font-size: 40px;
      font-style: italic;
      color: #1a3a8f;
      text-align: center;
      font-family: Georgia, 'Times New Roman', serif;
      border-bottom: 1.5px solid #1a3a8f;
      padding-bottom: 2px;
      padding-left: 18px;
      padding-right: 18px;
      margin-bottom: 7px;
      line-height: 1.2;
    }

    .body-text {
      font-size: 13px;
      color: #444;
      text-align: center;
      margin-bottom: 3px;
    }

    .course-name {
      font-size: 19px;
      font-weight: 700;
      color: #1a3a8f;
      text-align: center;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .details {
      font-size: 10.5px;
      color: #555;
      text-align: center;
      max-width: 560px;
      line-height: 1.5;
    }

    /* Signature row */
    .sig-row {
      position: absolute;
      bottom: 72px;
      left: 0; right: 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 0 85px;
      z-index: 6;
    }

    .sig-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 165px;
    }

    .sig-img {
      max-height: 48px;
      width: auto;
      display: block;
      margin-bottom: 2px;
    }

    .sig-line {
      width: 190px;
      height: 1px;
      background: #333;
      margin-bottom: 4px;
    }

    .sig-name {
      font-size: 10.5px;
      font-weight: 700;
      color: #1a3a8f;
      text-align: center;
    }

    .sig-title {
      font-size: 9.5px;
      color: #555;
      text-align: center;
    }

    /* Seal centered between sigs */
    .seal-wrap {
      position: absolute;
      bottom: 56px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 7;
    }

    .seal-img {
      width: 125px;
      height: 125px;
      display: block;
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Full-page decorative wave lines: dense S-curve ribbon from top-right, flowing through page middle -->
  <svg class="waves-decor" viewBox="0 0 842 595" xmlns="http://www.w3.org/2000/svg">
    <g stroke="#aad4f0" stroke-width="0.85" fill="none" opacity="0.9">
      <!-- Main wave ribbon: enters top-right (~x=842,y=0..120), bends left through middle (~x=100-300,y=180-280), exits toward lower-right -->
      <path d="M842,5  C760,25 680,35 580,75 C460,122 340,108 220,148 C130,178 60,195 0,205"/>
      <path d="M842,12 C762,31 682,41 582,81 C462,128 342,114 222,154 C132,184 62,201 2,211"/>
      <path d="M842,19 C764,37 684,47 584,87 C464,134 344,120 224,160 C134,190 64,207 4,217"/>
      <path d="M842,26 C766,43 686,53 586,93 C466,140 346,126 226,166 C136,196 66,213 6,223"/>
      <path d="M842,33 C768,49 688,59 588,99 C468,146 348,132 228,172 C138,202 68,219 8,229"/>
      <path d="M842,40 C770,55 690,65 590,105 C470,152 350,138 230,178 C140,208 70,225 10,235"/>
      <path d="M842,47 C772,61 692,71 592,111 C472,158 352,144 232,184 C142,214 72,231 12,241"/>
      <path d="M842,54 C774,67 694,77 594,117 C474,164 354,150 234,190 C144,220 74,237 14,247"/>
      <path d="M842,61 C776,73 696,83 596,123 C476,170 356,156 236,196 C146,226 76,243 16,253"/>
      <path d="M842,68 C778,79 698,89 598,129 C478,176 358,162 238,202 C148,232 78,249 18,259"/>
      <path d="M842,75 C780,85 700,95 600,135 C480,182 360,168 240,208 C150,238 80,255 20,265"/>
      <path d="M842,82 C782,91 702,101 602,141 C482,188 362,174 242,214 C152,244 82,261 22,271"/>
      <path d="M842,89 C784,97 704,107 604,147 C484,194 364,180 244,220 C154,250 84,267 24,277"/>
      <path d="M842,96 C786,103 706,113 606,153 C486,200 366,186 246,226 C156,256 86,273 26,283"/>
      <path d="M842,103 C788,109 708,119 608,159 C488,206 368,192 248,232 C158,262 88,279 28,289"/>
      <path d="M842,110 C790,115 710,125 610,165 C490,212 370,198 250,238 C160,268 90,285 30,295"/>
      <path d="M842,117 C792,121 712,131 612,171 C492,218 372,204 252,244 C162,274 92,291 32,301"/>
      <path d="M842,124 C794,127 714,137 614,177 C494,224 374,210 254,250 C164,280 94,297 34,307"/>
      <path d="M842,131 C796,133 716,143 616,183 C496,230 376,216 256,256 C166,286 96,303 36,313"/>
      <path d="M842,138 C798,139 718,149 618,189 C498,236 378,222 258,262 C168,292 98,309 38,319"/>
    </g>
  </svg>

  <!-- Bottom navy + light-blue wave -->
  <svg class="waves-bottom" viewBox="0 0 842 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <!-- Light blue upper wave layer -->
    <path d="M0,42 C90,22 200,60 310,38 C420,16 520,55 630,34 C720,18 790,42 842,28 L842,120 L0,120 Z" fill="#b8ddf7" opacity="0.55"/>
    <!-- Navy main wave -->
    <path d="M0,62 C100,42 210,78 320,55 C430,32 530,72 640,50 C730,33 800,58 842,46 L842,120 L0,120 Z" fill="#102354"/>
  </svg>

  <!-- Main content -->
  <div class="content">
    <img class="logo" src="data:image/png;base64," alt="Global Lynx">
    <div class="cert-title">CONSTANCIA</div>
    <div class="preamble">Se otorga el presente constancia a:</div>
    <div class="recipient-name">{{recipientName}}</div>
    <div class="body-text">Por haber completado satisfactoriamente el curso:</div>
    <div class="course-name">{{courseName}}</div>
    <div class="details">Con una duración de 40 horas, cubriendo análisis de ciberseguridad, gestión de vulnerabilidades, detección de amenazas y respuesta a incidentes en entornos empresariales.</div>
  </div>

  <!-- Two signatures -->
  <div class="sig-row">
    <div class="sig-block">
      <img class="sig-img" src="data:image/png;base64," alt="Firma">
      <div class="sig-line"></div>
      <div class="sig-name">Lic. Daniel Ortega Vargas</div>
      <div class="sig-title">Chief Executive Officer</div>
    </div>
    <div class="sig-block">
      <img class="sig-img" src="data:image/png;base64," alt="Firma">
      <div class="sig-line"></div>
      <div class="sig-name">Mtro. Alejandro Hernández Ruiz</div>
      <div class="sig-title">Instructor:</div>
    </div>
  </div>

  <!-- Circular seal centered -->
  <div class="seal-wrap">
    <img class="seal-img" src="data:image/png;base64," alt="Sello Global Lynx">
  </div>

</div>
</body>
</html>