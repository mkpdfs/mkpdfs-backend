<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><style>
{{{mkpdfsFontFaces}}}
@page { size: A4 landscape; margin: 0; }
* { margin:0; padding:0; box-sizing:border-box; }
html,body { width:297mm; height:210mm; font-family:'Inter',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; color:#1a2b5c; -webkit-font-smoothing:antialiased; }
.page { width:297mm; height:210mm; position:relative; overflow:hidden; background:#fff; }
.waves { position:absolute; top:0; left:0; width:100%; height:100%; z-index:1; }
.navy { position:absolute; bottom:0; left:0; width:100%; height:13%; z-index:2; }
.content { position:absolute; top:0; left:0; right:0; bottom:0; z-index:5; display:flex; flex-direction:column; align-items:center; text-align:center; padding-top:13mm; }
.logo { height:17mm; width:auto; margin-bottom:8px; }
.logo-wrap svg { height:100%; width:auto; }
.title { font-size:42px; font-weight:800; color:#1f3a93; letter-spacing:2px; margin-bottom:16px; }
.lede { font-size:15px; color:#3a3a3a; margin-bottom:12px; }
.recip { font-family:'Fraunces',Georgia,serif; font-style:italic; font-weight:600; font-size:44px; color:#1f3a93; line-height:1; border-bottom:2px solid #1f3a93; padding:0 30px 6px; margin-bottom:18px; }
.lede2 { font-size:15px; color:#3a3a3a; margin-bottom:10px; }
.course { font-size:24px; font-weight:800; letter-spacing:5px; color:#1f3a93; margin-bottom:14px; }
.details { font-size:13.5px; color:#555; max-width:640px; line-height:1.55; }
.seal { position:absolute; left:50%; bottom:34px; transform:translateX(-50%); z-index:7; }
.footer { position:absolute; left:0; right:0; bottom:46px; display:flex; justify-content:space-between; align-items:flex-end; padding:0 60px; z-index:6; }
.sig { width:240px; text-align:center; }
.sig svg { display:block; margin:0 auto -2px; }
.sig-line { width:200px; height:1px; background:#222; margin:0 auto 5px; }
.sig-name { font-size:14px; font-weight:700; color:#13234d; }
.sig-title { font-size:11px; color:#555; }
</style></head><body>
