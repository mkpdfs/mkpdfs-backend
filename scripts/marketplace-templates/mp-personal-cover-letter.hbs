<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces}}}

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --brand: #8C6CFF;
      --brand-soft: #F3EFFF;
      --brand-shadow: rgba(140, 108, 255, 0.28);
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: var(--font-body);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Letterhead ---- */
    .letterhead {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding-bottom: 20px; border-bottom: 1px solid var(--ink);
    }
    .brand-mark { display: flex; align-items: center; gap: 12px; }
    .brand-dot {
      width: 34px; height: 34px; border-radius: 9px;
      background: var(--brand);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 600; font-size: 16px;
      box-shadow: 0 4px 12px var(--brand-shadow);
      text-transform: uppercase; flex-shrink: 0;
    }
    .brand-logo { height: 34px; width: auto; max-width: 160px; object-fit: contain; display: block; }
    .applicant-name {
      font-family: var(--font-heading);
      font-size: 26px; font-weight: 600; letter-spacing: -0.015em; line-height: 1;
    }
    .applicant-title {
      margin-top: 5px; font-size: 12px; font-weight: 600;
      letter-spacing: 0.03em; color: var(--accent);
    }
    .contact {
      text-align: right; font-size: 11px; color: var(--muted); line-height: 1.7;
    }
    .contact .em { color: var(--ink); font-weight: 500; }

    /* ---- Date + recipient ---- */
    .date {
      margin-top: 26px; font-size: 11.5px; color: var(--faint);
      font-weight: 600; letter-spacing: 0.04em;
    }
    .recipient { margin-top: 20px; font-size: 12.5px; line-height: 1.65; }
    .recipient .rn { font-weight: 600; }
    .recipient .rt, .recipient .ra { color: var(--muted); }
    .recipient .rc { font-weight: 600; color: var(--accent); }

    .subject {
      margin-top: 24px; padding-bottom: 16px;
      font-size: 13px; font-weight: 600; letter-spacing: -0.01em;
      border-bottom: 1px solid var(--hair);
    }
    .subject .re {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.13em;
      text-transform: uppercase; color: var(--faint); margin-right: 8px;
    }

    /* ---- Body ---- */
    .body { margin-top: 22px; }
    .body p { font-size: 12.5px; line-height: 1.7; color: var(--ink); margin-bottom: 14px; }

    .highlight {
      margin: 18px 0; padding: 16px 20px;
      background: var(--accent-soft); border-left: 3px solid var(--accent);
      border-radius: 0 10px 10px 0;
      font-family: var(--font-heading);
      font-size: 14px; font-weight: 500; line-height: 1.5; color: var(--ink);
    }

    .achievements { margin: 4px 0 18px; list-style: none; }
    .achievements li {
      position: relative; padding-left: 20px; margin-bottom: 8px;
      font-size: 12.5px; line-height: 1.55; color: var(--ink);
    }
    .achievements li::before {
      content: ''; position: absolute; left: 0; top: 6px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    }

    /* ---- Sign off ---- */
    .signoff { margin-top: 24px; }
    .signoff .close { font-size: 12.5px; color: var(--ink); }
    .signoff .sig {
      margin-top: 10px;
      font-family: var(--font-heading);
      font-size: 20px; font-weight: 600; letter-spacing: -0.01em;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="letterhead">
      <div class="brand-mark">
        {{mkpdfsLogo applicantName}}
        <div>
          <div class="applicant-name">{{applicantName}}</div>
          <div class="applicant-title">{{applicantTitle}}</div>
        </div>
      </div>
      <div class="contact">
        <div class="em">{{applicantEmail}}</div>
        <div>{{applicantPhone}}</div>
        <div>{{applicantLocation}}</div>
        <div>{{applicantLinkedIn}}</div>
      </div>
    </div>

    <div class="date">{{date}}</div>

    <div class="recipient">
      <div class="rn">{{hiringManagerName}}</div>
      <div class="rt">{{hiringManagerTitle}}</div>
      <div class="rc">{{companyName}}</div>
      <div class="ra">{{companyAddress}}</div>
    </div>

    <div class="subject"><span class="re">Re</span>Application for {{positionTitle}}</div>

    <div class="body">
      <p>{{openingParagraph}}</p>

      <div class="highlight">{{highlightText}}</div>

      <p>{{experienceParagraph}}</p>

      <ul class="achievements">
        {{#each keyAchievements}}
        <li>{{this}}</li>
        {{/each}}
      </ul>

      <p>{{whyCompanyParagraph}}</p>

      <p>{{closingParagraph}}</p>
    </div>

    <div class="signoff">
      <div class="close">Sincerely,</div>
      <div class="sig">{{applicantName}}</div>
    </div>
  </div>
</body>
</html>
