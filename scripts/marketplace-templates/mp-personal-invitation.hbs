<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 26mm 24mm;
      background: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .frame {
      width: 100%;
      flex: 1;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 30mm 18mm;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .kicker {
      font-size: 10.5px; font-weight: 600; letter-spacing: 0.28em;
      text-transform: uppercase; color: var(--accent);
    }

    /* ---- Flourish divider ---- */
    .flourish {
      display: flex; align-items: center; gap: 9px;
      margin: 20px 0;
    }
    .flourish .line { width: 46px; height: 1px; background: var(--line); }
    .flourish .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
    .flourish .dot.sm { width: 3px; height: 3px; background: var(--faint); }

    .event-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 52px; font-weight: 600; letter-spacing: -0.02em;
      line-height: 1.04; max-width: 320px;
    }

    .hosted {
      margin-top: 22px; font-size: 13px; color: var(--muted); line-height: 1.7;
    }
    .hosted .host {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 16px; font-weight: 500; color: var(--ink);
    }
    .hosted .honoree {
      margin-top: 4px; font-size: 12px; font-weight: 600;
      letter-spacing: 0.04em; color: var(--accent);
    }

    /* ---- Details ---- */
    .details {
      margin-top: 30px; padding-top: 26px;
      width: 100%; max-width: 340px;
      border-top: 1px solid var(--hair);
    }
    .detail-row { margin-bottom: 16px; }
    .detail-label {
      font-size: 9px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 5px;
    }
    .detail-value {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 17px; font-weight: 500; color: var(--ink); line-height: 1.3;
    }
    .detail-sub { font-size: 11.5px; color: var(--muted); margin-top: 3px; }

    /* ---- Theme + dress ---- */
    .meta-rows {
      margin-top: 8px; width: 100%; max-width: 340px;
      display: flex; gap: 0;
    }
    .meta-rows .mcell { flex: 1; }
    .meta-rows .mcell + .mcell { border-left: 1px solid var(--hair); }
    .meta-label {
      font-size: 9px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 4px;
    }
    .meta-value { font-size: 12px; font-weight: 500; color: var(--ink); }

    /* ---- RSVP ---- */
    .rsvp {
      margin-top: 30px; width: 100%; max-width: 340px;
      padding: 18px 22px;
      background: var(--accent-soft); border-radius: 12px;
    }
    .rsvp-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--accent); margin-bottom: 8px;
    }
    .rsvp-by {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 15px; font-weight: 500; color: var(--ink);
    }
    .rsvp-contact { margin-top: 6px; font-size: 11.5px; color: var(--muted); line-height: 1.6; }

    .footnote {
      margin-top: auto; padding-top: 24px;
      font-size: 10.5px; color: var(--faint); line-height: 1.6;
      max-width: 360px; font-style: italic;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="frame">
      <div class="kicker">{{eventType}}</div>

      <div class="flourish">
        <span class="line"></span>
        <span class="dot sm"></span>
        <span class="dot"></span>
        <span class="dot sm"></span>
        <span class="line"></span>
      </div>

      <div class="event-title">{{eventTitle}}</div>

      <div class="hosted">
        <div class="host">Hosted by {{hostName}}</div>
        <div class="honoree">In honor of {{honoree}}</div>
      </div>

      <div class="details">
        <div class="detail-row">
          <div class="detail-label">When</div>
          <div class="detail-value">{{date}}</div>
          <div class="detail-sub">{{time}}</div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Where</div>
          <div class="detail-value">{{venue}}</div>
          <div class="detail-sub">{{address}}</div>
        </div>
      </div>

      <div class="meta-rows">
        <div class="mcell">
          <div class="meta-label">Theme</div>
          <div class="meta-value">{{theme}}</div>
        </div>
        <div class="mcell">
          <div class="meta-label">Dress Code</div>
          <div class="meta-value">{{dressCode}}</div>
        </div>
      </div>

      <div class="rsvp">
        <div class="rsvp-label">Kindly RSVP</div>
        <div class="rsvp-by">by {{rsvpBy}}</div>
        <div class="rsvp-contact">{{rsvpContact}} &middot; {{rsvpPhone}}</div>
      </div>

      <div class="footnote">{{specialInstructions}}</div>
    </div>
  </div>
</body>
</html>
