<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces}}}

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --brand: #8C6CFF;
      --brand-soft: #F3EFFF;
      --brand-shadow: rgba(140, 108, 255, 0.28);
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: var(--font-body);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Ceremonial double-rule frame ---- */
    .frame {
      flex: 1;
      border: 1px solid var(--line);
      padding: 4px;
      display: flex;
    }
    .frame-inner {
      flex: 1;
      border: 1px solid var(--accent);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 26mm 22mm;
    }

    /* ---- Micro-labels ---- */
    .kicker {
      font-size: 10px; font-weight: 600; letter-spacing: 0.28em;
      text-transform: uppercase; color: var(--faint);
    }
    .lede { font-size: 12.5px; color: var(--muted); letter-spacing: 0.02em; }

    /* ---- Title ---- */
    .title {
      font-family: var(--font-heading);
      font-size: 30px; font-weight: 500; letter-spacing: 0.01em;
      line-height: 1.1; margin-top: 14px;
    }
    .title-rule { width: 46px; height: 2px; background: var(--accent); margin: 20px auto 0; }

    /* ---- Recipient ---- */
    .recipient {
      font-family: var(--font-heading);
      font-size: 58px; font-weight: 600; letter-spacing: -0.01em;
      line-height: 1.05; margin: 8px 0;
    }

    /* ---- Achievement pill ---- */
    .achievement {
      display: inline-block;
      padding: 9px 22px;
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      border-radius: 999px;
      font-size: 16px; font-weight: 600; letter-spacing: 0.02em;
      color: var(--accent);
    }

    /* ---- Description ---- */
    .description {
      font-size: 13.5px; line-height: 1.7; color: var(--muted);
      max-width: 120mm; margin: 0 auto;
    }

    /* ---- Award date ---- */
    .award-date {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--faint);
    }
    .award-date strong { color: var(--ink); font-weight: 600; }

    /* ---- Seal ---- */
    .seal { margin: 6px 0; }

    /* ---- Signature ---- */
    .sig-line { width: 220px; height: 1px; background: var(--ink); margin: 0 auto 9px; }
    .sig-name { font-family: var(--font-heading); font-size: 17px; font-weight: 500; }
    .sig-title {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--faint); margin-top: 4px;
    }

    /* ---- Footer ---- */
    .cert-footer {
      display: flex; align-items: center; justify-content: center;
      gap: 12px; margin-top: 4px;
      font-size: 10.5px; color: var(--faint); letter-spacing: 0.04em;
    }
    .cert-footer strong { color: var(--muted); font-weight: 600; }

    .gap-l { height: 30px; }
    .gap-m { height: 20px; }
    .gap-s { height: 12px; }
  </style>
</head>
<body>
  <div class="page">
    <div class="frame">
      <div class="frame-inner">
        <div class="kicker">{{organizationName}}</div>
        <div class="title">{{title}}</div>
        <div class="title-rule"></div>

        <div class="gap-l"></div>

        <div class="lede">Presented to</div>
        <div class="recipient">{{recipientName}}</div>

        <div class="gap-s"></div>

        <div class="achievement">{{achievementTitle}}</div>

        <div class="gap-m"></div>

        <div class="description">{{description}}</div>

        <div class="gap-m"></div>

        <div class="award-date">Awarded <strong>{{awardDate}}</strong></div>

        <div class="gap-l"></div>

        <div class="seal">
          <svg width="84" height="84" viewBox="0 0 84 84" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="42" cy="42" r="40" style="stroke: var(--brand)" stroke-width="1"/>
            <circle cx="42" cy="42" r="33" style="stroke: var(--brand)" stroke-width="0.6" opacity="0.55"/>
            <circle cx="42" cy="42" r="22" style="fill: var(--brand-soft)"/>
            <path d="M42 28l3.95 8 8.83 1.28-6.39 6.23 1.51 8.79L42 56.16l-7.9 4.15 1.51-8.79-6.39-6.23L38.05 36 42 28z" style="fill: var(--brand)"/>
          </svg>
        </div>

        <div class="gap-s"></div>

        <div class="signature">
          <div class="sig-line"></div>
          <div class="sig-name">{{presenterName}}</div>
          <div class="sig-title">{{presenterTitle}}</div>
        </div>

        <div class="gap-l"></div>

        <div class="cert-footer">
          <strong>{{organizationName}}</strong>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
