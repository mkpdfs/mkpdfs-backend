<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces}}}

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --brand: #8C6CFF;
      --brand-soft: #F3EFFF;
      --brand-shadow: rgba(140, 108, 255, 0.28);
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: var(--font-body);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Masthead ---- */
    .masthead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--line);
    }
    .brand-mark {
      display: flex;
      align-items: center;
      gap: 11px;
      margin-bottom: 12px;
    }
    .brand-dot {
      width: 30px; height: 30px;
      border-radius: 8px;
      background: var(--brand);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 600; font-size: 15px;
      box-shadow: 0 4px 12px var(--brand-shadow);
      text-transform: uppercase;
    }
    .brand-logo { height: 30px; width: auto; max-width: 160px; object-fit: contain; display: block; }
    .company-name {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .company-meta { font-size: 11.5px; color: var(--muted); line-height: 1.7; max-width: 230px; }

    .doc-label { text-align: right; }
    .doc-label .kicker {
      font-family: var(--font-heading);
      font-size: 34px;
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1;
    }
    .doc-num {
      margin-top: 8px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* ---- Meta grid ---- */
    .meta { display: flex; margin-top: 26px; margin-bottom: 34px; }
    .meta-block { flex: 1; padding-right: 24px; }
    .meta-block + .meta-block { padding-left: 24px; border-left: 1px solid var(--hair); }
    .meta-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.13em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 7px;
    }
    .meta-value { font-size: 13px; line-height: 1.6; }
    .meta-value strong { font-weight: 600; }
    .meta-row { display: flex; justify-content: space-between; font-size: 12.5px; line-height: 1.9; }
    .meta-row span:first-child { color: var(--muted); }

    /* ---- Items ---- */
    table { width: 100%; border-collapse: collapse; }
    thead th {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--faint);
      text-align: left; padding: 0 0 11px; border-bottom: 1px solid var(--ink);
    }
    thead th.num, tbody td.num { text-align: right; }
    tbody td {
      font-size: 13px; padding: 14px 0;
      border-bottom: 1px solid var(--hair); vertical-align: top;
    }
    tbody td.desc { font-weight: 500; }
    tbody td.num { color: var(--muted); font-variant-numeric: tabular-nums; }
    tbody td.amount { color: var(--ink); font-weight: 600; }

    /* ---- Totals ---- */
    .totals { margin-top: 22px; margin-left: auto; width: 46%; }
    .totals-row {
      display: flex; justify-content: space-between;
      font-size: 13px; padding: 8px 0; color: var(--muted);
    }
    .totals-row span:last-child { color: var(--ink); font-variant-numeric: tabular-nums; }
    .totals-grand {
      display: flex; justify-content: space-between; align-items: baseline;
      margin-top: 8px; padding: 16px 18px;
      background: var(--accent-soft); border-radius: 10px;
    }
    .totals-grand .lbl {
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--accent);
    }
    .totals-grand .val {
      font-family: var(--font-heading);
      font-size: 26px; font-weight: 600; color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    /* ---- Footer ---- */
    .footer { margin-top: auto; padding-top: 26px; }
    .terms {
      display: flex; gap: 14px; align-items: flex-start;
      padding: 16px 18px; border: 1px solid var(--line); border-radius: 10px;
    }
    .terms .tick {
      width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
      margin-top: 6px; flex-shrink: 0;
    }
    .terms-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 4px;
    }
    .terms-text { font-size: 12.5px; color: var(--ink); line-height: 1.55; }
    .sign-off {
      margin-top: 20px; text-align: center;
      font-size: 11.5px; color: var(--faint); letter-spacing: 0.02em;
    }
    .sign-off strong { color: var(--muted); font-weight: 500; }
  </style>
</head>
<body>
  <div class="page">
    <div class="masthead">
      <div>
        <div class="brand-mark">
          {{mkpdfsLogo companyName}}
          <div class="company-name">{{companyName}}</div>
        </div>
        <div class="company-meta">{{companyAddress}}<br>{{companyEmail}}</div>
      </div>
      <div class="doc-label">
        <div class="kicker">Invoice</div>
        <div class="doc-num">{{invoiceNumber}}</div>
      </div>
    </div>

    <div class="meta">
      <div class="meta-block">
        <div class="meta-label">Billed To</div>
        <div class="meta-value"><strong>{{clientName}}</strong><br>{{clientAddress}}</div>
      </div>
      <div class="meta-block">
        <div class="meta-label">Details</div>
        <div class="meta-row"><span>Issued</span><span>{{invoiceDate}}</span></div>
        <div class="meta-row"><span>Due</span><span>{{dueDate}}</span></div>
        <div class="meta-row"><span>Terms</span><span>{{paymentTerms}}</span></div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th class="num">Qty</th>
          <th class="num">Rate</th>
          <th class="num">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td class="desc">{{description}}</td>
          <td class="num">{{quantity}}</td>
          <td class="num">{{formatCurrency rate}}</td>
          <td class="num amount">{{formatCurrency amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="totals">
      <div class="totals-row"><span>Subtotal</span><span>{{formatCurrency subtotal}}</span></div>
      <div class="totals-row"><span>Tax ({{taxRate}}%)</span><span>{{formatCurrency taxAmount}}</span></div>
      <div class="totals-grand">
        <span class="lbl">Total Due</span>
        <span class="val">{{formatCurrency total}}</span>
      </div>
    </div>

    <div class="footer">
      <div class="terms">
        <div class="tick"></div>
        <div>
          <div class="terms-label">Payment</div>
          <div class="terms-text">Kindly settle the balance by the due date above. Reference invoice {{invoiceNumber}} on your transfer.</div>
        </div>
      </div>
      <div class="sign-off"><strong>Thank you for your business.</strong></div>
    </div>
  </div>
</body>
</html>
