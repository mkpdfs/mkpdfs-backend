<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces "inter-inter"}}}

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 297mm; height: 210mm;
      font-family: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    .page {
      width: 297mm; height: 210mm;
      position: relative; overflow: hidden; background: #fff;
    }

    /* Red sidebar (full height, left) */
    .bar { position: absolute; left: 0; top: 0; bottom: 0; width: 14mm; background: #e2231a; }

    /* Content column, clear of the bar */
    .body { position: absolute; left: 28mm; right: 20mm; top: 16mm; }

    .logo { height: 20mm; width: auto; display: block; margin-bottom: 16mm; }

    .otorga { font-size: 15pt; color: #1a1a1a; font-weight: 400; margin-bottom: 6mm; }
    .titulo { font-size: 23pt; color: #000; font-weight: 400; letter-spacing: .01em; margin-bottom: 12mm; }

    .recip { font-size: 30pt; color: #000; font-weight: 600; line-height: 1.05; margin-bottom: 12mm; }
    .recip .a { font-size: 13pt; font-weight: 400; vertical-align: baseline; margin-right: 4mm; }

    .curso { font-size: 21pt; color: #000; font-weight: 400; line-height: 1.25; margin-bottom: 9mm; max-width: 200mm; }

    .impartido { font-size: 14pt; color: #1a1a1a; font-weight: 400; line-height: 1.4; margin-bottom: 6mm; max-width: 180mm; }
    .valor { font-size: 14pt; color: #1a1a1a; font-weight: 400; }

    /* Footer */
    .foot-left { position: absolute; left: 28mm; bottom: 16mm; }
    .motto { font-size: 13pt; font-style: italic; color: #1a1a1a; margin-bottom: 4mm; }
    .lugar { font-size: 13pt; font-style: italic; color: #1a1a1a; }

    .foot-right { position: absolute; right: 24mm; bottom: 16mm; text-align: left; }
    .sig-name { font-size: 14pt; font-style: italic; font-weight: 600; color: #000; }
    .sig-title { font-size: 12pt; font-style: italic; color: #1a1a1a; }
  </style>
</head>
<body>
  <div class="page">
    <div class="bar"></div>
    <div class="body">
      <img class="logo" src="data:image/png;base64," alt="UPAEP">
      <div class="otorga">UPAEP otorga la presente</div>
      <div class="titulo">CONSTANCIA</div>
      <div class="recip"><span class="a">A:</span>{{recipientName}}</div>
      <div class="curso">Por su participación en el Curso Virtual de: {{courseName}}</div>
      <div class="impartido">Impartido por esta Universidad el 15 de mayo de 2025 al 15 de julio de 2025</div>
      <div class="valor">Valor curricular: 40 horas</div>
    </div>

    <div class="foot-left">
      <div class="motto">“La cultura al servicio del Pueblo”</div>
      <div class="lugar">Puebla, Pue. Agosto 2024</div>
    </div>
    <div class="foot-right">
      <div class="sig-name">Ing. Cesar Orozco Gamiño</div>
      <div class="sig-title">Director Académico de Ingenierías UPAEP</div>
    </div>
  </div>
</body>
</html>
