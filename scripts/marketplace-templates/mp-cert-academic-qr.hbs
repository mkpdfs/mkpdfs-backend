<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces "inter-fraunces"}}}

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 297mm; height: 210mm;
      font-family: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    .page {
      width: 297mm; height: 210mm;
      position: relative; overflow: hidden;
      background: #ffffff;
    }

    .swoosh {
      position: absolute;
      top: 0; right: 0;
      width: 100%; height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    .bottom-bar {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 8px;
      background: #8a1538;
      z-index: 10;
    }

    .content {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 27mm 60px 20px 60px;
    }

    .logo-wrap { margin-bottom: 6px; }
    .logo { height: 56px; width: auto; }

    .university-name {
      font-size: 27px;
      font-weight: 800;
      color: #111;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
      line-height: 1.1;
    }

    .certifica {
      font-size: 15px;
      color: #333;
      font-weight: 400;
      margin-bottom: 18px;
    }

    .recipient {
      font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
      font-size: 50px;
      font-weight: 900;
      color: #111;
      line-height: 1.06;
      letter-spacing: -0.01em;
      margin-top: 6px;
      margin-bottom: 20px;
      max-width: 230mm;
    }

    .course-text {
      font-size: 13.5px;
      color: #333;
      font-weight: 400;
      line-height: 1.45;
      margin-bottom: 4px;
      max-width: 160mm;
    }
    .course-name-inline {
      font-weight: 700;
      color: #111;
      font-style: normal;
    }

    .spacer { display: none; }

    .bottom-row {
      position: absolute;
      left: 60px; right: 60px; bottom: 110px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .qr-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      min-width: 82px;
    }
    .qr-label { font-size: 9px; color: #555; margin-bottom: 4px; }
    .qr-img { width: 74px; height: 74px; image-rendering: pixelated; }
    .qr-url {
      font-size: 6.5px;
      color: #555;
      word-break: break-all;
      max-width: 82px;
      margin-top: 3px;
      line-height: 1.3;
    }

    .date-area {
      position: absolute;
      left: 0; right: 0;
      bottom: 205px;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      color: #111;
      z-index: 6;
    }

    .sig-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .sig-img { height: 46px; width: auto; }
    .sig-signed-by { font-size: 8.5px; color: #888; margin-top: 2px; }
    .sig-name { font-size: 13px; font-weight: 700; color: #111; margin-top: 1px; }
    .sig-title { font-size: 9.5px; color: #555; max-width: 95mm; line-height: 1.3; }
  </style>
</head>
<body>
<div class="page">

  <svg class="swoosh" viewBox="0 0 1122 793" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M1122 0 L1122 793 L815 793 C655 655 640 375 762 198 C842 86 982 22 1122 0 Z" fill="#eef0f2"/>
    <path d="M1122 55 L1122 793 L905 793 C783 668 772 432 862 282 C932 168 1032 96 1122 55 Z" fill="#f7f7f9"/>
  </svg>

  <div class="bottom-bar"></div>
  <div class="date-area">Puebla, Pue. a 20 de octubre 2024</div>

  <div class="content">

    <div class="logo-wrap">
      <img class="logo" src="data:image/png;base64," alt="udla">
    </div>

    <div class="university-name">Universidad de Las Am&#233;ricas</div>
    <div class="certifica">Certifica que:</div>
    <div class="recipient">{{recipientName}}</div>

    <div class="course-text">
      Ha participado y aprobado satisfactoriamente el curso de <span class="course-name-inline">{{courseName}}</span>
    </div>

    <div class="spacer"></div>

    <div class="bottom-row">
      

      

      <div class="sig-section">
        <img class="sig-img" src="data:image/png;base64," alt="Firma">
        <div class="sig-signed-by">Digitally signed by</div>
        <div class="sig-name">Marlena Le&#243;n Mendoza</div>
        <div class="sig-title">Vicerrectora Acad&#233;mica de la Universidad de Las Am&#233;ricas</div>
      </div>
    </div>

  </div>
</div>
</body>
</html>