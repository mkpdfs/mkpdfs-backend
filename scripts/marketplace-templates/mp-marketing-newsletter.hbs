<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Masthead ---- */
    .masthead {
      display: flex; justify-content: space-between; align-items: center;
      padding-bottom: 16px; border-bottom: 1px solid var(--ink);
    }
    .brand-mark { display: flex; align-items: center; gap: 11px; }
    .brand-dot {
      width: 30px; height: 30px; border-radius: 8px;
      background: var(--accent);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 600; font-size: 15px;
      box-shadow: 0 4px 12px rgba(140, 108, 255, 0.28);
      text-transform: uppercase;
    }
    .company-name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 22px; font-weight: 600; letter-spacing: -0.01em;
    }
    .issue-meta { text-align: right; }
    .issue-num {
      font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--accent);
    }
    .issue-date { font-size: 11.5px; color: var(--muted); margin-top: 4px; }

    /* ---- Greeting ---- */
    .greeting {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 38px; font-weight: 600; letter-spacing: -0.02em;
      line-height: 1.05; margin: 30px 0 14px;
    }
    .intro {
      font-size: 13.5px; color: var(--muted); line-height: 1.7;
      max-width: 88%; margin-bottom: 28px;
    }

    /* ---- Articles ---- */
    .section-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.13em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 16px;
    }
    .articles { display: flex; flex-direction: column; gap: 0; }
    .article {
      padding: 18px 0; border-top: 1px solid var(--hair);
    }
    .article:first-child { border-top: none; padding-top: 0; }
    .article-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 19px; font-weight: 600; letter-spacing: -0.01em;
      line-height: 1.15; margin-bottom: 7px;
    }
    .article-summary {
      font-size: 12.5px; color: var(--muted); line-height: 1.65; margin-bottom: 9px;
    }
    .read-more {
      font-size: 11.5px; font-weight: 600; letter-spacing: 0.02em;
      color: var(--accent);
    }

    /* ---- CTA block ---- */
    .cta {
      margin-top: 26px;
      background: var(--accent-soft); border-radius: 14px;
      padding: 24px 26px; text-align: center;
    }
    .cta-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 22px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 7px;
    }
    .cta-text {
      font-size: 12.5px; color: var(--muted); line-height: 1.6;
      max-width: 80%; margin: 0 auto 16px;
    }
    .cta-btn {
      display: inline-block;
      font-size: 13px; font-weight: 600; letter-spacing: 0.01em;
      color: #fff; background: var(--accent);
      padding: 13px 34px; border-radius: 100px;
      box-shadow: 0 8px 20px rgba(140, 108, 255, 0.32);
    }

    /* ---- Footer ---- */
    .footer {
      margin-top: auto; padding-top: 22px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-brand { font-size: 11.5px; color: var(--faint); letter-spacing: 0.02em; }
    .social { display: flex; gap: 18px; }
    .social a {
      font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
      color: var(--accent); text-transform: uppercase;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="masthead">
      <div class="brand-mark">
        <div class="brand-dot">{{companyName.[0]}}</div>
        <div class="company-name">{{companyName}}</div>
      </div>
      <div class="issue-meta">
        <div class="issue-num">Issue #{{issueNumber}}</div>
        <div class="issue-date">{{issueDate}}</div>
      </div>
    </div>

    <h1 class="greeting">{{greeting}}</h1>
    <p class="intro">{{introText}}</p>

    <div class="section-label">In this issue</div>
    <div class="articles">
      {{#each articles}}
      <div class="article">
        <div class="article-title">{{title}}</div>
        <div class="article-summary">{{summary}}</div>
        <div class="read-more">Read more &rarr;</div>
      </div>
      {{/each}}
    </div>

    <div class="cta">
      <div class="cta-title">{{ctaTitle}}</div>
      <div class="cta-text">{{ctaText}}</div>
      <a class="cta-btn">{{ctaButton}}</a>
    </div>

    <div class="footer">
      <div class="footer-brand">{{companyName}}</div>
      <div class="social">
        <a>Twitter {{socialLinks.twitter}}</a>
        <a>LinkedIn {{socialLinks.linkedin}}</a>
        <a>Facebook {{socialLinks.facebook}}</a>
      </div>
    </div>
  </div>
</body>
</html>
