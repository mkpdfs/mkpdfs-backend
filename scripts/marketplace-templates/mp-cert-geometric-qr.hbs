<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><style>
{{{mkpdfsFontFaces "inter-inter"}}}
@page { size: A4 landscape; margin: 0; }
* { margin:0; padding:0; box-sizing:border-box; }
html,body { width:297mm; height:210mm; font-family:'Inter',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; color:#1a1a1a; -webkit-font-smoothing:antialiased; }
.page { width:297mm; height:210mm; position:relative; overflow:hidden; background:#fff; }
.geo { position:absolute; top:0; left:0; width:100%; height:100%; z-index:1; }
.logo-db { position:absolute; top:12mm; left:30mm; height:17mm; z-index:6; }
.logo-ap { position:absolute; top:9mm; right:18mm; height:24mm; z-index:6; }
.content { position:absolute; left:58mm; right:24mm; top:50mm; z-index:5; }
.recon { font-size:26px; color:#333; font-weight:400; margin-bottom:14px; }
.name { font-size:34px; font-weight:800; color:#111; letter-spacing:0.5px; margin-bottom:12px; }
.course { font-size:17px; color:#444; font-weight:600; max-width:150mm; }
.sign { position:absolute; left:58mm; bottom:34mm; z-index:6; text-align:center; }
.sign svg { display:block; margin:0 auto -6px; }
.sign-line { width:200px; height:1px; background:#222; margin:0 auto 4px; }
.sign-name { font-size:15px; font-weight:700; color:#111; }
.sign-title { font-size:11px; color:#555; }
.qr { position:absolute; right:30mm; bottom:40mm; z-index:6; width:34mm; text-align:center; }
.qr-label { font-size:9px; color:#444; margin-bottom:3px; }
.qr svg { width:100%; height:auto; }
.fecha { position:absolute; left:58mm; bottom:9mm; z-index:6; font-size:12px; font-weight:700; color:#222; }
</style></head><body>
<div class="page">
  <svg class="geo" viewBox="0 0 1122 793" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <polygon points="0,0 210,0 95,793 0,793" fill="#14532a"/>
    <polygon points="0,0 135,0 35,793 0,793" fill="#2e7d32"/>
    <polygon points="150,0 250,0 150,360" fill="#2e7d32" opacity="0.85"/>
    <polygon points="1122,660 1122,793 470,793" fill="#14532a"/>
    <polygon points="1122,720 1122,793 640,793" fill="#2e7d32"/>
  </svg>
  <img class="logo-db" src="data:image/png;base64," alt="databricks">
  <img class="logo-ap" src="data:image/png;base64," alt="A+">
  <div class="content">
    <div class="recon">Reconocimiento a:</div>
    <div class="name">{{recipientName}}</div>
    <div class="course">Por su participación y aprovechamiento en: {{courseName}}</div>
  </div>
  <div class="sign">
    <svg width="160" height="56" viewBox="0 0 160 56"><path d="M10 44 C26 8 36 50 52 26 C66 6 78 48 96 24 C112 4 126 46 150 14" fill="none" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round"/></svg>
    <div class="sign-line"></div>
    <div class="sign-name">Eduardo Barrón Delgado</div>
    <div class="sign-title">Director académico</div>
  </div>
  <div class="qr">
    <div class="qr-label">Verificar:</div>
    {{{mkpdfsQR "https://verifica.example.com/recon/2024-1023"}}}
  </div>
  <div class="fecha">Fecha de aprobación: 23 de octubre del 2024</div>
</div></body></html>