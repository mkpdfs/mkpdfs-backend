<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 26mm 24mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Letterhead ---- */
    .letterhead { padding-bottom: 22px; border-bottom: 1px solid var(--ink); }
    .sender-name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 30px; font-weight: 600; letter-spacing: -0.015em; line-height: 1;
    }
    .sender-meta {
      margin-top: 12px; font-size: 11px; color: var(--muted); line-height: 1.7;
      display: flex; flex-wrap: wrap; align-items: center; gap: 9px;
    }
    .sender-meta .sep {
      width: 3px; height: 3px; border-radius: 50%;
      background: var(--faint); flex-shrink: 0;
    }

    /* ---- Date ---- */
    .date {
      margin-top: 30px; text-align: right;
      font-size: 11.5px; color: var(--faint); font-weight: 600; letter-spacing: 0.04em;
    }

    /* ---- Recipient ---- */
    .recipient { margin-top: 26px; font-size: 12.5px; line-height: 1.7; }
    .recipient .rn { font-weight: 600; }
    .recipient .rt { color: var(--muted); }
    .recipient .rco { font-weight: 600; color: var(--accent); }
    .recipient .rad { color: var(--muted); }

    /* ---- Subject ---- */
    .subject {
      margin-top: 28px; font-size: 13.5px; font-weight: 600;
      letter-spacing: -0.01em; color: var(--ink);
    }

    .salutation { margin-top: 24px; font-size: 12.5px; color: var(--ink); }

    /* ---- Body ---- */
    .body { margin-top: 16px; }
    .body p {
      font-size: 12.5px; line-height: 1.8; color: var(--ink);
      margin-bottom: 16px; text-align: justify;
    }

    /* ---- Sign off ---- */
    .signoff { margin-top: 34px; }
    .signoff .close { font-size: 12.5px; color: var(--ink); margin-bottom: 26px; }
    .sig-rule { width: 200px; height: 1px; background: var(--line); }
    .signoff .sig {
      margin-top: 8px;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 18px; font-weight: 600; letter-spacing: -0.01em;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="letterhead">
      <div class="sender-name">{{senderName}}</div>
      <div class="sender-meta">
        <span>{{senderAddress}}</span>
        <span class="sep"></span>
        <span>{{senderCity}}</span>
        <span class="sep"></span>
        <span>{{senderEmail}}</span>
        <span class="sep"></span>
        <span>{{senderPhone}}</span>
      </div>
    </div>

    <div class="date">{{date}}</div>

    <div class="recipient">
      <div class="rn">{{recipientName}}</div>
      <div class="rt">{{recipientTitle}}</div>
      <div class="rco">{{recipientCompany}}</div>
      <div class="rad">{{recipientAddress}}</div>
      <div class="rad">{{recipientCity}}</div>
    </div>

    <div class="subject">{{subject}}</div>

    <div class="salutation">{{salutation}}</div>

    <div class="body">
      {{#each body}}
      <p>{{this}}</p>
      {{/each}}
    </div>

    <div class="signoff">
      <div class="close">{{closing}}</div>
      <div class="sig-rule"></div>
      <div class="sig">{{signature}}</div>
    </div>
  </div>
</body>
</html>
