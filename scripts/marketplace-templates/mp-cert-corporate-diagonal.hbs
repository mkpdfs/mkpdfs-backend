<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces "inter-inter"}}}

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 297mm; height: 210mm;
      font-family: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    .page {
      width: 297mm; height: 210mm;
      position: relative; overflow: hidden; background: #fff;
    }

    /* ---- Corner triangle decorations ---- */
    .corner-tl {
      position: absolute; top: 0; left: 0;
      width: 0; height: 0;
      z-index: 2;
    }
    .corner-br {
      position: absolute; bottom: 0; right: 0;
      width: 0; height: 0;
      z-index: 2;
    }

    /* ---- Logo top-right ---- */
    .logo-wrap {
      position: absolute;
      top: 18px; right: 24px;
      z-index: 10;
    }
    .logo-text {
      font-family: 'Inter', 'Segoe UI', Helvetica, Arial, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 30px;
      letter-spacing: -0.5px;
      color: #2e6db4;
      line-height: 1;
      white-space: nowrap;
    }

    /* ---- Main content (centered) ---- */
    .content {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding-top: 0;
      text-align: center;
    }

    .hero {
      font-size: 46px;
      font-weight: 800;
      color: #111;
      line-height: 1.1;
      letter-spacing: -0.01em;
      margin-bottom: 9px;
    }

    .preamble {
      font-size: 16px;
      color: #555;
      margin-bottom: 8px;
    }

    .recipient {
      font-size: 23px;
      font-weight: 700;
      color: #1f5fbf;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 11px;
    }

    .body-text {
      font-size: 16px;
      color: #444;
      margin-bottom: 8px;
    }

    .course-name {
      font-size: 22px;
      font-weight: 700;
      color: #111;
      line-height: 1.3;
      max-width: 180mm;
      margin-bottom: 8px;
    }

    .duration {
      font-size: 13px;
      color: #444;
      margin-bottom: 13mm;
    }

    /* ---- Signature ---- */
    .sig-block {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .sig-img {
      height: 18mm;
      width: auto;
      display: block;
      margin-bottom: -2px;
    }
    .sig-line {
      width: 72mm;
      height: 1.5px;
      background: #bc8d44;
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- Top-left diagonal corner (navy + gold inner stripe) -->
    <svg style="position:absolute;top:0;left:0;z-index:2;overflow:visible;" width="220" height="185" viewBox="0 0 220 185" xmlns="http://www.w3.org/2000/svg">
      <polygon points="0,0 220,0 0,185" fill="#003274"/>
      <polygon points="0,0 198,0 0,167" fill="none" stroke="#bc8d44" stroke-width="4"/>
    </svg>

    <!-- Bottom-right diagonal corner (same, rotated 180deg) -->
    <svg style="position:absolute;bottom:0;right:0;z-index:2;overflow:visible;transform:rotate(180deg);" width="220" height="185" viewBox="0 0 220 185" xmlns="http://www.w3.org/2000/svg">
      <polygon points="0,0 220,0 0,185" fill="#003274"/>
      <polygon points="0,0 198,0 0,167" fill="none" stroke="#bc8d44" stroke-width="4"/>
    </svg>

    <!-- NobleProg logo top-right -->
    <div class="logo-wrap">
      <div class="logo-text">NobleProg</div>
    </div>

    <!-- Main certificate content -->
    <div class="content">
      <div class="hero">NobleProg Servicios<br>Corporativos</div>

      <div class="preamble">Orotga la presente constancia a:</div>

      <div class="recipient">{{recipientName}}</div>

      <div class="body-text">Por haber cursado satisfactoriamente el curso de:</div>

      <div class="course-name">{{courseName}}</div>

      <div class="duration">Con duración de 21 horas.</div>

      <!-- Signature + gold line -->
      <div class="sig-block">
        <img class="sig-img" src="data:image/png;base64," alt="">
        <div class="sig-line"></div>
      </div>
    </div>

  </div>
</body>
</html>