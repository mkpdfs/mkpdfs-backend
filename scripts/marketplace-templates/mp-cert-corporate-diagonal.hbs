<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces}}}

    :root {
      --brand: {{#if brand.color}}{{brand.color}}{{else}}#1a3a8f{{/if}};
      --brand-2: {{#if brand.colorSecondary}}{{brand.colorSecondary}}{{else}}#c9a227{{/if}};
      --ink: #16151A;
      --muted: #5b5b66;
      --line: #d8d8de;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 297mm; height: 210mm; }

    .page {
      width: 297mm;
      height: 210mm;
      position: relative;
      overflow: hidden;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Corner triangle decorations ---- */
    .corner-svg-tl {
      position: absolute;
      top: 0;
      left: 0;
      width: 200px;
      height: 170px;
      overflow: visible;
      z-index: 2;
    }

    .corner-svg-br {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 200px;
      height: 170px;
      overflow: visible;
      z-index: 2;
      transform: rotate(180deg);
    }

    /* ---- Logo top-right ---- */
    .logo-wrap {
      position: absolute;
      top: 16px;
      right: 20px;
      z-index: 10;
    }
    .logo {
      max-height: 16mm;
      max-width: 72mm;
      object-fit: contain;
    }

    /* ---- Main content ---- */
    .content {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 48mm;
      text-align: center;
    }

    .cert-title {
      font-family: var(--font-body);
      font-size: 48px;
      font-weight: 800;
      color: var(--ink);
      line-height: 1.1;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }

    .preamble {
      font-size: 13px;
      color: var(--muted);
      font-style: italic;
      margin-bottom: 5px;
    }

    .recipient-name {
      font-size: 21px;
      font-weight: 700;
      color: var(--brand);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .body-text {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 5px;
    }

    .course-name {
      font-family: var(--font-heading);
      font-size: 17px;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.3;
      max-width: 150mm;
      margin-bottom: 4px;
    }

    .details-text {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
    }

    /* ---- Signature ---- */
    .sigs { display: flex; justify-content: center; gap: 36mm; }
    .sig { text-align: center; width: 70mm; }
    .sig-img { height: 16mm; object-fit: contain; display: block; margin: 0 auto -2mm; }
    .sig-line {
      width: 55mm;
      height: 2px;
      background: var(--brand-2);
      margin: 0 auto 6px;
    }
    .sig-name { font-family: var(--font-heading); font-size: 14px; font-weight: 600; }
    .sig-title { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 3px; }

    /* ---- Folio ---- */
    .folio {
      position: absolute;
      bottom: 10px;
      left: 20px;
      font-size: 8px;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: #aaa;
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- Top-left diagonal corner (navy + gold inner edge) -->
    <svg class="corner-svg-tl" viewBox="0 0 220 190" xmlns="http://www.w3.org/2000/svg">
      <!-- Outer navy triangle -->
      <polygon points="0,0 220,0 0,190" fill="{{#if brand.color}}{{brand.color}}{{else}}#1a3a8f{{/if}}"/>
      <!-- Gold inner edge (inset triangle outline) -->
      <polygon points="0,0 196,0 0,170" fill="none"
        stroke="{{#if brand.colorSecondary}}{{brand.colorSecondary}}{{else}}#c9a227{{/if}}"
        stroke-width="3"/>
    </svg>

    <!-- Bottom-right diagonal corner (same, rotated 180°) -->
    <svg class="corner-svg-br" viewBox="0 0 220 190" xmlns="http://www.w3.org/2000/svg">
      <polygon points="0,0 220,0 0,190" fill="{{#if brand.color}}{{brand.color}}{{else}}#1a3a8f{{/if}}"/>
      <polygon points="0,0 196,0 0,170" fill="none"
        stroke="{{#if brand.colorSecondary}}{{brand.colorSecondary}}{{else}}#c9a227{{/if}}"
        stroke-width="3"/>
    </svg>

    <!-- Logo top-right -->
    <div class="logo-wrap">
      {{#if brand.logoUrl}}<img class="logo" src="{{brand.logoUrl}}" alt="{{brand.name}}">{{/if}}
    </div>

    <!-- Main certificate content -->
    <div class="content">
      <div class="cert-title">{{title}}</div>

      <div class="preamble">{{preamble}}</div>

      <div class="recipient-name">{{recipientName}}</div>

      <div class="body-text">{{body}}</div>

      <div class="course-name">{{courseName}}</div>

      <div class="details-text">{{details}}</div>

      <!-- Signature block -->
      <div class="sigs">
        {{#each signatures}}
        <div class="sig">
          {{#if imageUrl}}<img class="sig-img" src="{{imageUrl}}" alt="">{{/if}}
          <div class="sig-line"></div>
          <div class="sig-name">{{name}}</div>
          {{#if title}}<div class="sig-title">{{title}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Folio bottom-left (optional) -->
    {{#if folio}}<div class="folio">{{folio}}</div>{{/if}}

  </div>
</body>
</html>
