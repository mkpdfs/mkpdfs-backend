<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Header ---- */
    .header { padding-bottom: 20px; border-bottom: 1px solid var(--ink); }
    .name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 40px;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .title {
      margin-top: 8px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--accent);
    }
    .contact {
      margin-top: 14px;
      font-size: 11.5px;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 9px;
    }
    .contact .sep {
      width: 4px; height: 4px; border-radius: 50%;
      background: var(--accent); flex-shrink: 0;
    }

    /* ---- Body columns ---- */
    .body { display: flex; gap: 30px; margin-top: 28px; }
    .col-main { flex: 1.85; min-width: 0; }
    .col-side { flex: 1; min-width: 0; }

    .section + .section { margin-top: 26px; }
    .section-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.13em;
      text-transform: uppercase; color: var(--faint);
      margin-bottom: 13px; padding-bottom: 8px;
      border-bottom: 1px solid var(--hair);
    }

    .summary { font-size: 12.5px; line-height: 1.65; color: var(--ink); }

    /* ---- Experience ---- */
    .exp + .exp { margin-top: 20px; }
    .exp-role { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
    .exp-meta {
      margin-top: 3px; font-size: 11.5px; color: var(--muted);
      display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    }
    .exp-company { font-weight: 500; color: var(--accent); }
    .exp-period { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .achievements { margin-top: 10px; list-style: none; }
    .achievements li {
      position: relative; padding-left: 18px; margin-bottom: 7px;
      font-size: 12px; line-height: 1.55; color: var(--ink);
    }
    .achievements li::before {
      content: ''; position: absolute; left: 0; top: 6px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    }

    /* ---- Sidebar ---- */
    .pills { display: flex; flex-wrap: wrap; gap: 7px; }
    .pill {
      font-size: 11px; font-weight: 500;
      padding: 5px 11px; border-radius: 20px;
      background: var(--accent-soft); color: var(--accent);
    }
    .edu-degree { font-size: 13px; font-weight: 600; line-height: 1.4; }
    .edu-school { margin-top: 4px; font-size: 12px; color: var(--muted); }
    .edu-year {
      margin-top: 6px; font-size: 10.5px; font-weight: 600;
      letter-spacing: 0.06em; color: var(--faint); font-variant-numeric: tabular-nums;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="name">{{name}}</div>
      <div class="title">{{title}}</div>
      <div class="contact">
        <span>{{email}}</span>
        <span class="sep"></span>
        <span>{{phone}}</span>
        <span class="sep"></span>
        <span>{{location}}</span>
        <span class="sep"></span>
        <span>{{linkedin}}</span>
      </div>
    </div>

    <div class="body">
      <div class="col-main">
        <div class="section">
          <div class="section-label">Profile</div>
          <div class="summary">{{summary}}</div>
        </div>

        <div class="section">
          <div class="section-label">Experience</div>
          {{#each experience}}
          <div class="exp">
            <div class="exp-role">{{role}}</div>
            <div class="exp-meta">
              <span class="exp-company">{{company}}</span>
              <span class="exp-period">{{period}}</span>
            </div>
            <ul class="achievements">
              {{#each achievements}}
              <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </div>
      </div>

      <div class="col-side">
        <div class="section">
          <div class="section-label">Skills</div>
          <div class="pills">
            {{#each skills}}
            <span class="pill">{{this}}</span>
            {{/each}}
          </div>
        </div>

        <div class="section">
          <div class="section-label">Education</div>
          <div class="edu-degree">{{education.degree}}</div>
          <div class="edu-school">{{education.school}}</div>
          <div class="edu-year">{{education.year}}</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
