<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --ink: #16151A;
      --muted: #6B6B76;
      --faint: #9A9AA4;
      --line: #E6E6EA;
      --hair: #F1F1F4;
      --brand: #8C6CFF;
      --brand-soft: #F3EFFF;
      --brand-shadow: rgba(140, 108, 255, 0.28);
      --accent: #8C6CFF;
      --accent-soft: #F3EFFF;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      font-family: var(--font-body);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'tnum' 1, 'cv05' 1;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 22mm 20mm;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* ---- Hero ---- */
    .kicker {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--accent); margin-bottom: 16px;
    }
    .hero-title {
      font-family: var(--font-heading);
      font-size: 52px; font-weight: 600; line-height: 1.02;
      letter-spacing: -0.02em; max-width: 92%;
    }
    .hero-tagline {
      font-family: var(--font-heading);
      font-size: 18px; font-weight: 400; font-style: italic;
      color: var(--accent); margin-top: 14px; letter-spacing: -0.01em;
    }
    .hero-desc {
      font-size: 13.5px; color: var(--muted); line-height: 1.7;
      max-width: 80%; margin-top: 14px;
    }
    .hero-rule { height: 1px; background: var(--line); margin: 26px 0 24px; }

    /* ---- Feature grid ---- */
    .section-label {
      font-size: 9.5px; font-weight: 600; letter-spacing: 0.13em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 16px;
    }
    .feature-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 16px 24px; margin-bottom: 30px;
    }
    .feature {
      padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px;
    }
    .feature-icon {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--accent); margin-bottom: 11px;
      box-shadow: 0 3px 8px rgba(140, 108, 255, 0.30);
    }
    .feature-title {
      font-size: 14px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 5px;
    }
    .feature-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }

    /* ---- Pricing ---- */
    .pricing {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 12px; margin-bottom: 28px;
    }
    .plan {
      border: 1px solid var(--line); border-radius: 12px;
      padding: 18px 16px; display: flex; flex-direction: column;
    }
    .plan.featured { background: var(--accent-soft); border-color: var(--accent); }
    .plan-tag {
      align-self: flex-start; font-size: 8.5px; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: #fff; background: var(--accent); padding: 3px 8px;
      border-radius: 100px; margin-bottom: 10px;
    }
    .plan-name {
      font-size: 10px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--faint); margin-bottom: 10px;
    }
    .plan.featured .plan-name { color: var(--accent); }
    .plan-price {
      font-family: var(--font-heading);
      font-size: 30px; font-weight: 600; letter-spacing: -0.01em;
      font-variant-numeric: tabular-nums; line-height: 1;
    }
    .plan-per { font-size: 10.5px; color: var(--faint); margin: 6px 0 14px; }
    .plan-feats { list-style: none; margin-top: 2px; }
    .plan-feats li {
      font-size: 11.5px; color: var(--ink); line-height: 1.4;
      padding: 6px 0 6px 16px; position: relative;
      border-top: 1px solid var(--hair);
    }
    .plan-feats li:first-child { border-top: none; }
    .plan-feats li::before {
      content: ''; position: absolute; left: 0; top: 11px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    }

    /* ---- CTA ---- */
    .cta { margin-top: auto; text-align: center; padding-top: 22px; }
    .cta-btn {
      display: inline-block;
      font-size: 14px; font-weight: 600; letter-spacing: 0.01em;
      color: #fff; background: var(--accent);
      padding: 16px 42px; border-radius: 100px;
      box-shadow: 0 8px 22px rgba(140, 108, 255, 0.34);
    }
    .cta-url { margin-top: 12px; font-size: 11px; color: var(--faint); letter-spacing: 0.04em; }
  </style>
</head>
<body>
  <div class="page">
    <div class="kicker">Product Overview</div>
    <h1 class="hero-title">{{productName}}</h1>
    <div class="hero-tagline">{{tagline}}</div>
    <p class="hero-desc">{{heroDescription}}</p>

    <div class="hero-rule"></div>

    <div class="section-label">What you get</div>
    <div class="feature-grid">
      {{#each features}}
      <div class="feature">
        <div class="feature-icon"></div>
        <div class="feature-title">{{title}}</div>
        <div class="feature-desc">{{description}}</div>
      </div>
      {{/each}}
    </div>

    <div class="section-label">Plans &amp; pricing</div>
    <div class="pricing">
      <div class="plan">
        <div class="plan-name">Starter</div>
        <div class="plan-price">{{formatCurrency pricing.starter.price}}</div>
        <div class="plan-per">per month</div>
        <ul class="plan-feats">
          {{#each pricing.starter.features}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      <div class="plan featured">
        <div class="plan-tag">Most popular</div>
        <div class="plan-name">Professional</div>
        <div class="plan-price">{{formatCurrency pricing.professional.price}}</div>
        <div class="plan-per">per month</div>
        <ul class="plan-feats">
          {{#each pricing.professional.features}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      <div class="plan">
        <div class="plan-name">Enterprise</div>
        <div class="plan-price">{{formatCurrency pricing.enterprise.price}}</div>
        <div class="plan-per">per month</div>
        <ul class="plan-feats">
          {{#each pricing.enterprise.features}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>

    <div class="cta">
      <a class="cta-btn">{{ctaText}}</a>
      <div class="cta-url">{{ctaUrl}}</div>
    </div>
  </div>
</body>
</html>
