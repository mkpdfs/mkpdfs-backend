<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    {{{mkpdfsFontFaces}}}

    :root {
      --brand: {{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}};
      --brand-2: {{#if brand.colorSecondary}}{{brand.colorSecondary}}{{else}}#7fb0d8{{/if}};
      --ink: #16151A;
      --muted: #5b5b66;
      --line: #d8d8de;
      --font-heading: 'Fraunces', Georgia, serif;
      --font-body: 'Inter', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    @page { size: A4 landscape; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 297mm; height: 210mm; }

    .page {
      width: 297mm;
      height: 210mm;
      position: relative;
      overflow: hidden;
      background: #fff;
    }

    /* ---- Ornamental double border ---- */
    .border-outer {
      position: absolute;
      top: 6mm;
      left: 6mm;
      right: 6mm;
      bottom: 6mm;
      border: 3px solid var(--brand);
    }

    .border-inner {
      position: absolute;
      top: 9mm;
      left: 9mm;
      right: 9mm;
      bottom: 9mm;
      border: 1px solid var(--brand);
    }

    /* ---- Corner medallions ---- */
    .corner {
      position: absolute;
      width: 28px;
      height: 28px;
      z-index: 20;
    }
    .corner-tl { top: 3.5mm; left: 3.5mm; transform: translate(-50%, -50%); }
    .corner-tr { top: 3.5mm; right: 3.5mm; transform: translate(50%, -50%); }
    .corner-bl { bottom: 3.5mm; left: 3.5mm; transform: translate(-50%, 50%); }
    .corner-br { bottom: 3.5mm; right: 3.5mm; transform: translate(50%, 50%); }

    /* ---- Content ---- */
    .content {
      position: absolute;
      top: 11mm;
      left: 12mm;
      right: 12mm;
      bottom: 11mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      padding: 3mm 16mm 2mm;
    }

    /* ---- Logo top-center ---- */
    .logo {
      display: block;
      max-height: 22mm;
      max-width: 70mm;
      width: auto;
      height: auto;
      object-fit: contain;
      margin-bottom: 8px;
    }

    .cert-title {
      font-family: var(--font-body);
      font-size: 48px;
      font-weight: 900;
      color: var(--brand);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      line-height: 1.0;
      margin-bottom: 8px;
    }

    .preamble {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--ink);
      margin-bottom: 6px;
    }

    .recipient-name {
      font-family: var(--font-body);
      font-size: 26px;
      font-weight: 800;
      color: var(--ink);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1.2;
      margin-bottom: 10px;
    }

    .body-text {
      font-family: var(--font-body);
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .course-name {
      font-family: var(--font-body);
      font-size: 22px;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .details-text {
      font-family: var(--font-body);
      font-size: 12px;
      color: var(--ink);
      line-height: 1.7;
      max-width: 195mm;
      margin-bottom: 0;
      text-align: left;
    }

    /* ---- Body content group ---- */
    .body-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    /* ---- Stamp SVG wrap ---- */
    .stamp-wrap {
      position: absolute;
      right: 62mm;
      bottom: 16mm;
      opacity: 0.4;
      z-index: 5;
    }

    /* ---- Signature block ---- */
    .sigs-row {
      display: flex;
      justify-content: center;
      gap: 40mm;
      padding-bottom: 2mm;
      width: 100%;
    }

    .sig {
      text-align: center;
      width: 68mm;
    }

    .sig-img {
      height: 14mm;
      object-fit: contain;
      display: block;
      margin: 0 auto -2mm;
    }

    .sig-line {
      width: 56mm;
      height: 1px;
      background: var(--ink);
      margin: 0 auto 5px;
    }

    .sig-name {
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 600;
      color: var(--ink);
    }

    .sig-title {
      font-size: 9px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 3px;
    }

    /* ---- Meta bottom ---- */
    .meta-line {
      position: absolute;
      bottom: 7mm;
      left: 0;
      right: 0;
      text-align: center;
      font-family: var(--font-body);
      font-size: 8.5px;
      color: var(--muted);
      letter-spacing: 0.05em;
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- Ornamental double border -->
    <div class="border-outer"></div>
    <div class="border-inner"></div>

    <!-- Corner medallions (4 corners) -->
    <!-- Top-left -->
    <svg class="corner corner-tl" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="24" height="24" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="1.5"/>
      <rect x="5" y="5" width="18" height="18" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8"/>
      <line x1="2" y1="14" x2="26" y2="14" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <line x1="14" y1="2" x2="14" y2="26" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <rect x="10" y="10" width="8" height="8" fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" fill-opacity="0.2" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8" transform="rotate(45 14 14)"/>
    </svg>

    <!-- Top-right -->
    <svg class="corner corner-tr" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="24" height="24" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="1.5"/>
      <rect x="5" y="5" width="18" height="18" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8"/>
      <line x1="2" y1="14" x2="26" y2="14" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <line x1="14" y1="2" x2="14" y2="26" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <rect x="10" y="10" width="8" height="8" fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" fill-opacity="0.2" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8" transform="rotate(45 14 14)"/>
    </svg>

    <!-- Bottom-left -->
    <svg class="corner corner-bl" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="24" height="24" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="1.5"/>
      <rect x="5" y="5" width="18" height="18" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8"/>
      <line x1="2" y1="14" x2="26" y2="14" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <line x1="14" y1="2" x2="14" y2="26" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <rect x="10" y="10" width="8" height="8" fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" fill-opacity="0.2" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8" transform="rotate(45 14 14)"/>
    </svg>

    <!-- Bottom-right -->
    <svg class="corner corner-br" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="24" height="24" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="1.5"/>
      <rect x="5" y="5" width="18" height="18" fill="none" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8"/>
      <line x1="2" y1="14" x2="26" y2="14" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <line x1="14" y1="2" x2="14" y2="26" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.6" stroke-opacity="0.6"/>
      <rect x="10" y="10" width="8" height="8" fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" fill-opacity="0.2" stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" stroke-width="0.8" transform="rotate(45 14 14)"/>
    </svg>

    <!-- Ink-style round stamp (decorative, near signatures) -->
    <div class="stamp-wrap">
      <svg width="80" height="80" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
        <circle cx="40" cy="40" r="38" fill="none"
          stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}"
          stroke-width="2.5"/>
        <circle cx="40" cy="40" r="30" fill="none"
          stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}"
          stroke-width="1"/>
        <circle cx="40" cy="40" r="14" fill="none"
          stroke="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}"
          stroke-width="1.2"/>
        <text x="40" y="44" text-anchor="middle"
          font-family="Arial, sans-serif" font-size="10"
          fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}" font-weight="bold">★</text>
        <defs>
          <path id="stamp-top" d="M 6,40 A 34,34 0 0 1 74,40"/>
          <path id="stamp-bot" d="M 74,40 A 34,34 0 0 1 6,40"/>
        </defs>
        <text font-family="Arial, sans-serif" font-size="7" font-weight="600" letter-spacing="1.2"
          fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}">
          <textPath href="#stamp-top" startOffset="50%" text-anchor="middle">{{brand.name}}</textPath>
        </text>
        <text font-family="Arial, sans-serif" font-size="6.5" letter-spacing="0.8"
          fill="{{#if brand.color}}{{brand.color}}{{else}}#1f6fb2{{/if}}">
          <textPath href="#stamp-bot" startOffset="50%" text-anchor="middle">SELLO OFICIAL</textPath>
        </text>
      </svg>
    </div>

    <!-- Main content -->
    <div class="content">

      <div class="body-group">
        {{#if brand.logoUrl}}<img class="logo" src="{{brand.logoUrl}}" alt="{{brand.name}}">{{/if}}

        <div class="cert-title">{{title}}</div>

        <div class="preamble">{{preamble}}</div>

        <div class="recipient-name">{{recipientName}}</div>

        <div class="body-text">{{body}}</div>

        <div class="course-name">{{courseName}}</div>

        <div class="details-text">{{details}}</div>
      </div>

      <!-- Two signatures -->
      <div class="sigs-row">
        {{#each signatures}}
        <div class="sig">
          {{#if imageUrl}}<img class="sig-img" src="{{imageUrl}}" alt="">{{/if}}
          <div class="sig-line"></div>
          <div class="sig-name">{{name}}</div>
          {{#if title}}<div class="sig-title">{{title}}</div>{{/if}}
        </div>
        {{/each}}
      </div>

    </div>

    <!-- Bottom meta line -->
    {{#if meta.location}}<div class="meta-line">{{meta.location}}</div>{{/if}}

  </div>
</body>
</html>
