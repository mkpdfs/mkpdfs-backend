{
  "name": "mkpdfs-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p cdk --noEmit",
    "lint": "echo \"No linter configured\"",
    "cdk:synth": "cd cdk && cdk synth -c environment=dev",
    "cdk:synth:prod": "cd cdk && cdk synth -c environment=prod",
    "cdk:diff": "cd cdk && AWS_PROFILE=rocketeast cdk diff --all -c environment=dev",
    "cdk:diff:prod": "cd cdk && AWS_PROFILE=rocketeast cdk diff --all -c environment=prod",
    "cdk:deploy:dev": "cd cdk && AWS_PROFILE=rocketeast cdk deploy --all -c environment=dev --require-approval never",
    "cdk:deploy:prod": "cd cdk && AWS_PROFILE=rocketeast cdk deploy --all -c environment=prod --require-approval never",
    "deploy:dev": "AWS_PROFILE=rocketeast serverless deploy --stage dev",
    "deploy:stage": "AWS_PROFILE=rocketeast serverless deploy --stage stage",
    "deploy:prod": "AWS_PROFILE=rocketeast serverless deploy --stage prod",
    "offline": "AWS_PROFILE=rocketeast IS_OFFLINE=true serverless offline --stage dev",
    "remove:dev": "AWS_PROFILE=rocketeast serverless remove --stage dev",
    "remove:stage": "AWS_PROFILE=rocketeast serverless remove --stage stage",
    "remove:prod": "AWS_PROFILE=rocketeast serverless remove --stage prod",
    "info:dev": "AWS_PROFILE=rocketeast serverless info --stage dev",
    "info:stage": "AWS_PROFILE=rocketeast serverless info --stage stage",
    "info:prod": "AWS_PROFILE=rocketeast serverless info --stage prod",
    "logs": "serverless logs -f $FUNCTION --stage dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@serverless/typescript": "^4.15.1",
    "@types/aws-lambda": "^8.10.150",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.7",
    "aws-cdk": "^2.1126.0",
    "aws-cdk-lib": "^2.258.1",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.25.5",
    "puppeteer-core": "^24.11.1",
    "serverless": "^3.40.0",
    "serverless-domain-manager": "^8.0.0",
    "serverless-esbuild": "^1.55.1",
    "serverless-offline": "^13.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.958.0",
    "@aws-sdk/client-dynamodb": "^3.839.0",
    "@aws-sdk/client-lambda": "^3.839.0",
    "@aws-sdk/client-s3": "^3.839.0",
    "@aws-sdk/client-ses": "^3.839.0",
    "@aws-sdk/client-sqs": "^3.839.0",
    "@aws-sdk/client-ssm": "^3.958.0",
    "@aws-sdk/lib-dynamodb": "^3.839.0",
    "@aws-sdk/s3-request-presigner": "^3.839.0",
    "@middy/core": "^6.3.2",
    "@middy/http-error-handler": "^6.3.2",
    "@middy/http-json-body-parser": "^6.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "qrcode-generator": "^1.5.2",
    "stripe": "^20.1.0",
    "twilio": "^5.11.1",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  }
}
